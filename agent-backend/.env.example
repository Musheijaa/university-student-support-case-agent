# Example environment variables for local development only.
# Do not commit real credentials or secrets.
APP_ENV=development
APP_NAME=student-support-case-agent
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Week 2: Groq foundation-model integration.
# Obtain a key from https://console.groq.com and set it locally in a
# real .env file. Never commit an actual key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Week 3: RAG configuration. Defaults in config.py work out of the box;
# only override these if you need something different locally.
EMBEDDING_MODEL=chroma-default
CHROMA_PERSIST_DIRECTORY=data/chroma
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
RAG_CORPUS_DIR=../docs/makerereUniversityPolicyDocs
RAG_COLLECTION_NAME=makerere_policy_docs

# Week 4: tools / function calling. Defaults work out of the box.
MAX_TOOL_CALLS=3
TIMETABLE_DATA_PATH=data/timetable/timetable.json
TICKETS_DB_PATH=data/tickets.db


# Week 5: bounded agent. Defaults work out of the box.
AGENT_MAX_ITERATIONS=4

# Week 6: bounded per-session memory (opt-in per request via the
# X-Memory header; MEMORY_ENABLED only sets the server's default when
# that header is absent). See docs/memory-design.md.
MEMORY_ENABLED=false
MEMORY_TTL_HOURS=24
MEMORY_DB_PATH=data/sessions.db

# Week 6: state store, privacy-filtered case history, and the
# observability trace log for every memory/state read/write/delete.
STATE_DB_PATH=data/session_state.db
CASE_HISTORY_DB_PATH=data/case_history.db
TRACES_DB_PATH=data/traces.db
